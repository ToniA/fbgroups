{
  "manifest_version": 3,
  "name": "Facebook Groups Home",
  "version": "1.0",
  "description": "Redirect Facebook home to Groups Feed.",
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}